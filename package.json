{
	"name": "tabelhahub",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"aggregate": "node scripts/aggregate.mjs",
		"syndicate": "node scripts/syndicate.mjs",
		"new-post": "node scripts/new-post.mjs",
		"dev": "vite dev",
		"build": "wrangler types && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"gen": "wrangler types",
		"deploy": "bun run aggregate && bun run build && wrangler deploy",
		"link:twui": "bun add file:../tabelhawebui",
		"publish:twui": "bun add @tabelhadev/tabelhawebui@latest"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/newsreader": "^5.3.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"mdsvex": "^0.12.8",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.28.0",
		"@tabelhadev/tabelhawebui": "^0.28.4",
		"front-matter": "^4.0.2",
		"mode-watcher": "^1.1.0"
	},
	"overrides": {
		"svelte": "$svelte"
	}
}
